local function randomRot()
    local tipo=math.random(1,10)
    if tipo<=2 then
        return math.random(-8,8)
    elseif tipo<=7 then
        local ang=math.random(25,70)
        if math.random(1,2)==1 then ang=-ang end
        return ang
    else
        return math.random(150,210)
    end
end

for n=1,quantidade do
    local tam=math.random(25,50)
    local xPos, yPos, ok
    for _=1,tentativasMax do
        xPos=math.random(pad, 180-tam-pad)
        yPos=math.random(pad, 320-tam-pad)
        local cx=xPos+tam/2
        local cy=yPos+tam/2
        local inCenter=(cx>zoneX1 and cx<zoneX2 and cy>zoneY1 and cy<zoneY2)
        ok=not inCenter
        if ok then
            for _,pnt in ipairs(espalhados)do
                local dx=math.abs(xPos-pnt.x)
                local dy=math.abs(yPos-pnt.y)
                if dx<16 and dy<16 then ok=false break end
            end
        end
        if ok then break end
    end
    table.insert(espalhados,{x=xPos,y=yPos})

