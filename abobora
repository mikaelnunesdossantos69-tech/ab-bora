    lbl.Size=UDim2.new(0,15,0,16)
    lbl.Position=UDim2.new(0,5,0,yPos)
    lbl.BackgroundTransparency=1
    lbl.Text=labelTxt
    lbl.TextColor3=Color3.fromRGB(60,60,60)
    lbl.Font=Enum.Font.PatrickHand
    lbl.TextSize=14
