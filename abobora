local SAVE_FILE="FeelingPanel_FogColors.json"
local savedSlots={false,false,false,false}

local function saveSlotsToFile()
    local data={}
    for i,s in ipairs(savedSlots)do
        if s then
            data[i]={r=s.r,g=s.g,b=s.b,intensity=s.intensity or 50,dark=s.dark or 0}
        end
    end
    pcall(function()
        if writefile then writefile(SAVE_FILE,HttpService:JSONEncode(data)) end
    end)
end

local function loadSlotsFromFile()
    pcall(function()
        if isfile and readfile and isfile(SAVE_FILE) then
            local data=HttpService:JSONDecode(readfile(SAVE_FILE))
            for i,s in ipairs(data)do
                if s and s.r and s.g and s.b then
                    savedSlots[i]={r=s.r,g=s.g,b=s.b,intensity=s.intensity or 50,dark=s.dark or 0}
                end
            end
        end
    end)
end

