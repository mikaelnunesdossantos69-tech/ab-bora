local function computeFogColor()
    local base=Color3.fromRGB(fogR,fogG,fogB)
    if fogDark>0 then
        local mult=1-fogDark
        return Color3.new(base.R*mult,base.G*mult,base.B*mult)
    end
    return base
end

local function refreshFog()
    local L2=game:GetService("Lighting")
    if fogOn then
        L2.FogColor=computeFogColor()
        L2.FogStart=0
        L2.FogEnd=2000-(fogIntensity/100)*1980
    elseif oldLightingOn then
        L2.FogColor=originalFogColor
        L2.FogStart=originalFogStart
        L2.FogEnd=100000000000000000000
    else
        L2.FogColor=originalFogColor
        L2.FogStart=originalFogStart
        L2.FogEnd=originalFogEnd
    end
    if fogOn then
        wf.BackgroundColor3=computeFogColor()
    else
        wf.BackgroundColor3=p
    end
end

local function applyFog()
    if fogOn then refreshFog() end
end

