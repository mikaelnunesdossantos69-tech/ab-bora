applyBtn.MouseButton1Click:Connect(function()
    local txt=(codeInput.Text or ""):gsub("%s","")
    local ok=false
    if txt:sub(1,1)=="#" then
        local hex=txt:sub(2)
        if #hex==6 then
            local rr=tonumber(hex:sub(1,2),16)
            local gg=tonumber(hex:sub(3,4),16)
            local bb=tonumber(hex:sub(5,6),16)
            if rr and gg and bb then fogR,fogG,fogB=rr,gg,bb ok=true end
        end
    else
        local parts={}
        for s in txt:gmatch("[^,]+") do table.insert(parts,s) end
        if #parts==3 then
            local rr=tonumber(parts[1]); local gg=tonumber(parts[2]); local bb=tonumber(parts[3])
            if rr and gg and bb then
                fogR=math.clamp(math.floor(rr),0,255)
                fogG=math.clamp(math.floor(gg),0,255)
                fogB=math.clamp(math.floor(bb),0,255)
                ok=true
            end
        end
    end
    if ok then updateRGBSliders() applyFog() end
end)

local function makeColorSlider(yPos,labelTxt,trackColor,fillColor,getVal,setVal)
